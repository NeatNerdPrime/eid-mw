; apg8201z.inf
; Copyright (C) 2011-2023 Advanced Card Systems Ltd. All rights reserved.
;
; APG8201Z Smart Card Reader Driver

[Version]
DriverVer = 06/13/2023,2.2.1.0
Signature="$Windows NT$"
Class=SmartCardReader
ClassGuid={50DD5230-BA8A-11D1-BF5D-0000F805F530}
Provider=%ACS%
DriverPackageType=PlugAndPlay
DriverPackageDisplayName=%DriverDisplayName%
CatalogFile=apg8201z.cat
PnpLockDown=1

[SourceDisksNames]
1=%SourceDiskName%,,,""

[SourceDisksFiles]
apg8201z.sys=1

[DestinationDirs]
ACS.APG8201Z.CopyFiles=12

[Manufacturer]
%ACS%=ACS,NTamd64

[ACS]
%ACS.APG8201Z.DevDesc%=ACS.APG8201Z,USB\VID_072F&PID_8205
%ACS.APG8201Z.DevDesc%=ACS.APG8201Z,USB\VID_072F&PID_8202

[ACS.NTamd64]
%ACS.APG8201Z.DevDesc%=ACS.APG8201Z,USB\VID_072F&PID_8205
%ACS.APG8201Z.DevDesc%=ACS.APG8201Z,USB\VID_072F&PID_8202

[ACS.APG8201Z]
AddReg=ACS.APG8201Z.AddReg,ACS.Common.AddReg
CopyFiles=ACS.APG8201Z.CopyFiles

[ACS.APG8201Z.CopyFiles]
apg8201z.sys,,,2

[ACS.APG8201Z.AddReg]
HKR,,"IFDName",0,%IFDName.APG8201Z%
HKR,,"DRIVERNAME",0,"APG8201Z"
HKR,,"ACSCustomFlags",0x00010000,"0006","0014","0019","0023","0028"
HKR,,"LCDRegistryPath",0,"\Registry\Machine\Software\Advanced Card Systems Ltd.\APG8201Z\LCD"

[ACS.APG8201Z.Services]
AddService=APG8201Z,2,ACS.APG8201Z.Service,ACS.APG8201Z.EventLog

[ACS.APG8201Z.Service]
DisplayName=%ACS.APG8201Z.DevDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\apg8201z.sys

[ACS.APG8201Z.EventLog]
AddReg=ACS.APG8201Z.AddEventLog.reg

[ACS.APG8201Z.AddEventLog.reg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\drivers\apg8201z.sys"
HKR,,TypesSupported,0x00010001,7

[ACS.Common.AddReg]
HKR,,AdapterType,0,"0100"
HKR,,"VendorName",0,%Vendor%
HKR,,"CardType",0,%CardType%
HKR,,"SFDT",0,%SFDT%
HKR,,"CardVoltage",0,%CardVoltage%
HKLM,"Software\Microsoft\Cryptography\Calais\Readers",,,

[Strings]
SourceDiskName="APG8201Z Smart Card Reader Driver Installation Disk"
Vendor="ACS"
ACS="Advanced Card Systems Ltd."
CardType=0
SFDT="TRUE"
CardVoltage=0
ACS.APG8201Z.DevDesc="APG8201Z Smart Card Reader"
IFDName.APG8201Z="APG8201Z"
DriverDisplayName="APG8201Z Unified PC/SC Driver"
